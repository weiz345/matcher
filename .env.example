# Copy to .env and paste the Session pooler URI from Supabase Dashboard → Connect.
# Replace the password placeholder with its URL-encoded value. Never commit .env.
# Use the session pooler (port 5432), not the transaction pooler (6543).
HINGE_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
